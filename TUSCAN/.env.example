# Tuscan Verve - Production Deployment Environment Variables

# -------------------------------------------------------------
# 1. Domain Configuration
# -------------------------------------------------------------
# Set this to your live domain/subdomain pointing to your server's IP
API_DOMAIN=ecommerce-api.yourdomain.com

# Email used for Let's Encrypt SSL certificate registration and renewal notices
CERTBOT_EMAIL=admin@yourdomain.com

# -------------------------------------------------------------
# 2. Application Secrets & Security
# -------------------------------------------------------------
# Strong random secret key for JWT authentication tokens
JWT_SECRET=tuscan_verve_ultra_secret_production_key_replace_this_with_random_string

# Node Environment (production / development)
NODE_ENV=production

# -------------------------------------------------------------
# 3. CORS & Allowed Origins
# -------------------------------------------------------------
# Comma-separated list of allowed frontend domains
CLIENT_URL=http://localhost:5173,http://localhost:5174,https://tuscanverve.store,https://admin.tuscanverve.store

# -------------------------------------------------------------
# 4. Frontend API Endpoint (for Docker builds)
# -------------------------------------------------------------
# Set to /api if proxied via Nginx or full https://ecommerce-api.yourdomain.com/api
VITE_API_BASE=/api
